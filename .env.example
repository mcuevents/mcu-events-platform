# MCU Creations Environment Variables Example
# Copy this file to .env.local for local development

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Production Domain Configuration
NEXT_PUBLIC_SITE_URL=https://mcucreations.com

# Transactional Email Service (Resend / SMTP)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM_ADDRESS=notifications@mcucreations.com
EMAIL_FROM_NAME=MCU Creations

# Official WhatsApp Business API (Meta Developer Console)
WHATSAPP_API_KEY=your_meta_whatsapp_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Analytics Integrations (Managed via Admin CMS or Env)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-XXXXXXX
